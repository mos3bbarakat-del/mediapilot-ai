# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEV_AUTH=true

# API — development defaults are intentionally local and simple.
MP_ENV=development
MP_DATABASE_URL=sqlite:///./mediapilot.db
MP_REDIS_URL=redis://localhost:6379/0
MP_CORS_ORIGINS=http://localhost:3000
MP_AUTO_CREATE_SCHEMA=true

# Identity — development only. Production should use oidc.
MP_AUTH_MODE=development
MP_DEV_ORGANIZATION_ID=11111111-1111-4111-8111-111111111111
MP_DEV_SUBJECT=local-admin
MP_OIDC_ISSUER=
MP_OIDC_AUDIENCE=
MP_OIDC_JWKS_URL=
MP_OIDC_ORGANIZATION_CLAIM=org_id
MP_OIDC_ROLES_CLAIM=roles
MP_OIDC_ALGORITHM=RS256

# Production database example:
# MP_DATABASE_URL=postgresql+psycopg://user:password@postgres-host:5432/mediapilot
